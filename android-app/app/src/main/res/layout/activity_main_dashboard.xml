<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_canvas"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mainDashboardToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/brand_primary"
        android:title="@string/home_title"
        android:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SchoolMS.SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="30dp">

                <LinearLayout
                    android:id="@+id/homeHeroPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dashboard_hero"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/portalBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_surface"
                            android:paddingLeft="12dp"
                            android:paddingTop="6dp"
                            android:paddingRight="12dp"
                            android:paddingBottom="6dp"
                            android:text="Campus hub"
                            android:textColor="@color/brand_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/dashboardProfileCard"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            app:cardBackgroundColor="#F8FEFF"
                            app:cardCornerRadius="38dp"
                            app:cardElevation="5dp"
                            app:strokeColor="#C9EEFF"
                            app:strokeWidth="2dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/dashboardProfileAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Profile photo"
                                android:padding="4dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_school_crest"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_SchoolMS_Circle" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/short_school_name"
                        android:textColor="#1D4ED8"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/welcomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeSummaryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Open academics, school updates, and campus tools from a polished central dashboard."
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/topAnnouncementCard"
                style="@style/Widget.SchoolMS.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_announcement_premium"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_surface"
                            android:paddingLeft="12dp"
                            android:paddingTop="6dp"
                            android:paddingRight="12dp"
                            android:paddingBottom="6dp"
                            android:text="LIVE ANNOUNCEMENTS"
                            android:textColor="@color/dashboard_orange"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/topAnnouncementHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Running school updates"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/topAnnouncementTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/topAnnouncementBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Launchpad"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Open the most important parts of the school app from a cleaner control surface."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/roleDashboardButton"
                style="@style/Widget.SchoolMS.DashboardButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dashboard_button_blue"
                android:text="@string/open_dashboard"
                app:backgroundTint="@null"
                app:icon="@android:drawable/ic_menu_manage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pendingApprovalsButton"
                style="@style/Widget.SchoolMS.DashboardButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_button_violet"
                android:text="Pending approvals"
                android:visibility="gone"
                app:backgroundTint="@null"
                app:icon="@android:drawable/ic_menu_info_details" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SchoolMS.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="School essentials"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Quick access to the public-facing campus, enquiry, gallery, and information sections."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/facilitiesButton"
                            style="@style/Widget.SchoolMS.SmallDashboardButton"
                            android:layout_width="0dp"
                            android:layout_height="94dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dashboard_button_violet"
                            android:text="Facilities"
                            app:backgroundTint="@null"
                            app:icon="@android:drawable/ic_menu_compass" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/galleryButton"
                            style="@style/Widget.SchoolMS.SmallDashboardButton"
                            android:layout_width="0dp"
                            android:layout_height="94dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dashboard_button_blue"
                            android:text="Gallery"
                            app:backgroundTint="@null"
                            app:icon="@android:drawable/ic_menu_gallery" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/admissionButton"
                            style="@style/Widget.SchoolMS.SmallDashboardButton"
                            android:layout_width="0dp"
                            android:layout_height="94dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dashboard_button_blue"
                            android:text="Admission&#10;Enquiry"
                            app:backgroundTint="@null"
                            app:icon="@android:drawable/ic_input_add" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/feedbackButton"
                            style="@style/Widget.SchoolMS.SmallDashboardButton"
                            android:layout_width="0dp"
                            android:layout_height="94dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dashboard_button_violet"
                            android:text="Feedback&#10;Form"
                            app:backgroundTint="@null"
                            app:icon="@android:drawable/ic_dialog_email" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timetableButton"
                        style="@style/Widget.SchoolMS.DashboardButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_dashboard_button_violet"
                        android:text="Timetable"
                        app:backgroundTint="@null"
                        app:icon="@android:drawable/ic_menu_today" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/eventsButton"
                        style="@style/Widget.SchoolMS.DashboardButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_dashboard_button_blue"
                        android:text="Events"
                        app:backgroundTint="@null"
                        app:icon="@android:drawable/ic_menu_my_calendar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/contentButton"
                        style="@style/Widget.SchoolMS.DashboardButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_dashboard_button_blue"
                        android:text="School Content"
                        app:backgroundTint="@null"
                        app:icon="@android:drawable/ic_menu_info_details" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ourStaffButton"
                        style="@style/Widget.SchoolMS.DashboardButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_dashboard_button_violet"
                        android:text="Our Staff"
                        app:backgroundTint="@null"
                        app:icon="@android:drawable/ic_menu_myplaces" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ourScholarsCard"
                style="@style/Widget.SchoolMS.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_scholars_premium"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Our Scholars"
                            android:textColor="@color/brand_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editScholarsButton"
                            style="@style/Widget.SchoolMS.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:text="Edit"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ourScholarsMarquee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:textColor="@color/dashboard_orange"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SchoolMS.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/contactDetailsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reach CNS"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editContactButton"
                            style="@style/Widget.SchoolMS.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:text="Edit"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/contactPhoneText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/brand_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/contactEmailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/dashboard_teal"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/contactOtherText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/dashboard_orange"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appUpdateCard"
                style="@style/Widget.SchoolMS.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F8FFFB"
                app:strokeColor="#BFE7D0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_surface"
                        android:paddingLeft="10dp"
                        android:paddingTop="5dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="5dp"
                        android:text="App update"
                        android:textColor="@color/brand_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/appUpdateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/appUpdateBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/appUpdateVersionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/appUpdateActionButton"
                            style="@style/Widget.SchoolMS.AppUpdateCompactButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_profile_about_button"
                            android:text="Update"
                            app:backgroundTint="@null"
                            app:icon="@android:drawable/ic_popup_sync"
                            app:iconTint="@android:color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/appUpdateEditButton"
                            style="@style/Widget.SchoolMS.AppUpdateCompactButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_dashboard_button_violet"
                            android:text="Edit"
                            android:visibility="gone"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/passwordResetRequestsButton"
                style="@style/Widget.SchoolMS.DashboardButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dashboard_button_teacher_updates"
                android:text="Password reset requests"
                android:visibility="gone"
                app:backgroundTint="@null"
                app:icon="@android:drawable/ic_lock_lock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.SchoolMS.LogoutButton"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_dashboard_button_logout"
                android:text="@string/logout"
                app:backgroundTint="@null"
                app:icon="@android:drawable/ic_lock_power_off" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
