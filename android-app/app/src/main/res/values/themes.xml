<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SchoolMS" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowBackground">@drawable/bg_screen_canvas</item>
        <item name="materialCardViewStyle">@style/Widget.SchoolMS.Card</item>
        <item name="materialButtonStyle">@style/Widget.SchoolMS.Button</item>
    </style>

    <style name="Theme.SchoolMS.Splash" parent="Theme.SchoolMS">
        <item name="android:windowBackground">@color/brand_primary</item>
    </style>

    <style name="Widget.SchoolMS.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
    </style>

    <style name="Widget.SchoolMS.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>

    <style name="Widget.SchoolMS.SurfaceCard" parent="Widget.SchoolMS.Card">
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/stroke_soft</item>
    </style>

    <style name="Widget.SchoolMS.SectionCard" parent="Widget.SchoolMS.Card">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardBackgroundColor">@color/surface_card_alt</item>
        <item name="strokeColor">@color/stroke_accent</item>
    </style>

    <style name="Widget.SchoolMS.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/stroke_accent</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="Widget.SchoolMS.DashboardButton" parent="Widget.SchoolMS.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:maxLines">3</item>
        <item name="elevation">3dp</item>
        <item name="rippleColor">@android:color/white</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.SchoolMS.SmallDashboardButton" parent="Widget.SchoolMS.DashboardButton">
        <item name="android:minHeight">84dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.SchoolMS.AppUpdateCompactButton" parent="Widget.SchoolMS.Button">
        <item name="android:minHeight">34dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.SchoolMS.RoleDashboardButton" parent="Widget.SchoolMS.DashboardButton">
        <item name="android:minHeight">144dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.SchoolMS.LogoutButton" parent="Widget.SchoolMS.DashboardButton">
        <item name="android:minHeight">50dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="ShapeAppearanceOverlay_SchoolMS_Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
