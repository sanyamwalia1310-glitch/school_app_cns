<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SchoolMS" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_secondary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSurface">@color/night_surface</item>
        <item name="android:statusBarColor">@color/night_surface</item>
        <item name="android:navigationBarColor">@color/night_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="materialCardViewStyle">@style/Widget.SchoolMS.Card</item>
    </style>

    <style name="Theme.SchoolMS.Splash" parent="Theme.SchoolMS">
        <item name="android:windowBackground">@color/night_surface</item>
    </style>

    <style name="Widget.SchoolMS.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
    </style>
</resources>
